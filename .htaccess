Options -Indexes
RewriteEngine On

# ---- Canonical host: force https and strip www (SEO: one canonical origin). ----
# X-Forwarded-Proto keeps this loop-free behind shared-host SSL proxies/CDNs.
# If your host has no SSL certificate yet, comment these 4 lines until AutoSSL is on.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---- Block direct web access to source, data, tooling and docs. ----
# (Public assets are served from /assets/; everything else routes through index.php.)
RewriteRule ^(src|storage|bin|seo)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known) - [F,L]
RewriteRule \.(md|lock|sh)$ - [F,L]

# ---- Front controller: route all non-file, non-directory requests to index.php. ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# ---- Compression (safe no-op when the module is absent). ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---- Browser caching for static assets. ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# ---- Security + caching headers (mod_headers fallback when mod_expires is absent). ----
<IfModule mod_headers.c>
    # Browsers only honour HSTS over https, so sending it unconditionally is safe.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always unset X-Powered-By
    # CSS/JS links carry a ?v= content fingerprint, so long-lived caching is safe.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|webp|avif)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.svg$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
<IfModule mod_php.c>
    php_flag expose_php Off
</IfModule>
